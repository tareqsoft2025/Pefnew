# انسخ إلى .env خارج الويب الجذر، ولا تضعه في Git. لا أسرار حقيقية هنا.
APP_ENV=production
# التشغيل تحت مسار فرعي، مثل /Tasks لرابط https://tarsof.top/Tasks (فارغ = جذر النطاق)
APP_BASE_PATH=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fleet
DB_USER=fleet
DB_PASS=
# مسار تخزين الصور (يفضل خارج public_html)
STORAGE_DIR=
# أصول CORS المسموحة للوحة/تطبيقات ويب (فاصلة). اتركه فارغًا لمنع كل الأصول الأجنبية
CORS_ORIGINS=
# Firebase (FCM HTTP v1): مسار ملف Service Account JSON خارج المستودع. فارغ = بلا Push (polling فقط)
FCM_SERVICE_ACCOUNT_JSON=
# مزود SMS عام عبر HTTP (فارغ = لا إرسال، تُسجل الحالة failed بصدق)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=Fleet
SMS_WEBHOOK_SECRET=
# رقم قناة SOS الاحتياطية (SMS من هاتف السائق)
SOS_FALLBACK_SMS_NUMBER=
# مزود المسارات (فارغ = خط مستقيم يعدّله المدير). مثال: خادم OSRM خاص
ROUTING_OSRM_URL=
